---
/** Ficha de identidad del doctorando (solo lectura). */
import type { DoctorandoProfile } from '../../types/student';
import { formatFecha } from '../../lib/fechas';
import { etiquetaSexo } from '../../lib/expediente-labels';
import Card from '../panel/Card.astro';
import SectionHeading from '../panel/SectionHeading.astro';
import DataField from '../panel/DataField.astro';

interface Props {
  doctorando: DoctorandoProfile;
}
const { doctorando } = Astro.props;

const campos = [
  { label: 'Cédula', value: doctorando.cedula },
  { label: 'Nombres', value: doctorando.nombres },
  { label: 'Apellidos', value: doctorando.apellidos },
  { label: 'Correo institucional', value: doctorando.correoInstitucional },
  { label: 'Teléfono', value: doctorando.telefono },
  { label: 'Sexo', value: doctorando.sexo ? etiquetaSexo(doctorando.sexo) : null },
  { label: 'Fecha de nacimiento', value: doctorando.fechaNacimiento ? formatFecha(doctorando.fechaNacimiento) : null },
  { label: 'Carpeta física', value: doctorando.carpeta },
  { label: 'N.º en la nómina', value: doctorando.numeroOrden ? String(doctorando.numeroOrden) : null },
];
---
<Card>
  <SectionHeading title="Datos personales" subtitle="Información de la nómina de la Unidad de Gestión de Doctorados.">
    <span slot="aside" class="text-xs text-muted">Solo lectura</span>
  </SectionHeading>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-5">
    {campos.map((c) => <DataField label={c.label} value={c.value} />)}
  </div>
  <p class="mt-6 pt-4 border-t border-border-subtle text-xs text-muted leading-relaxed">
    Si algún dato es incorrecto, solicita su actualización en la Unidad de Gestión de Doctorados.
  </p>
</Card>
