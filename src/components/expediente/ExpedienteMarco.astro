---
/** Marco común de las páginas del expediente: cabecera del doctorando o aviso si no hay ficha vinculada. */
import { FolderArchive } from 'lucide-react';
import type { DoctorandoProfile, ExpedienteDoctoralReal } from '../../types/student';
import ProfileHeader from './ProfileHeader.astro';

interface Props {
  doctorando: DoctorandoProfile | null;
  expediente: ExpedienteDoctoralReal | null;
}
const { doctorando, expediente } = Astro.props;
---
{
  doctorando ? (
    <article class="space-y-6">
      <ProfileHeader doctorando={doctorando} expediente={expediente} />
      <slot />
    </article>
  ) : (
    <div class="rounded-xl border border-dashed border-border bg-surface p-10 text-center">
      <FolderArchive className="mx-auto h-10 w-10 text-muted-foreground" />
      <h2 class="mt-3 font-serif text-xl text-text-main">Expediente no sincronizado</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted leading-relaxed">
        No encontramos una ficha doctoral vinculada a tu cuenta. Si eres estudiante del programa, comunícate con la Unidad de
        Gestión de Doctorados.
      </p>
    </div>
  )
}
