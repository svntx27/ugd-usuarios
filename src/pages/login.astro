---
import AuthLayout from '../layouts/AuthLayout.astro';
import { LoginForm } from '../components/auth/LoginForm';

// El aviso de mantenimiento llega en la URL (?maintenance=true) cuando la UGD bloquea el portal
const mantenimiento = Astro.url.searchParams.get('maintenance') === 'true';
---
<AuthLayout
  title="Iniciar sesión"
  heading="Tu potencial es infinito."
  subheading="El conocimiento es la herramienta más poderosa. Bienvenido a tu espacio de creación e innovación."
  imageSrc="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2070&auto=format&fit=crop"
  reverse
>
  <header class="mb-10 text-center">
    <h2 class="font-serif text-3xl font-bold tracking-tight text-text-main">Bienvenido</h2>
    <p class="mt-2 text-sm text-text-body">
      ¿Eres doctorando y aún no tienes cuenta?{' '}
      <a href="/activar" class="font-medium text-primary hover:underline">Activa tu cuenta aquí</a>
    </p>
  </header>

  <LoginForm client:load mantenimientoInicial={mantenimiento} />
</AuthLayout>
