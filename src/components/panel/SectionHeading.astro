---
interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
---
<header class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 mb-5 border-b border-border-subtle">
  <div>
    <h3 class="font-serif text-xl text-text-main leading-tight">{title}</h3>
    {subtitle && <p class="text-xs text-muted mt-1">{subtitle}</p>}
  </div>
  <slot name="aside" />
</header>
